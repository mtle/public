; -----------------------------------------------
; vlan7.rev
; -----------------------------------------------

$TTL 2d         ; default time to live

$ORIGIN 7.168.192.in-addr.arpa.
@       IN SOA ns1.linkon.dedyn.io. admin.linkon.dedyn.io. (
                2026081200  ; serial number
                2d          ; Refresh every 1d
                1h          ; update retry every 1 hour
                4W          ; Expire in 4 weeks
                1d          ; Min TTL = 1 day
                )

       IN       NS      x96.linkon.dedyn.io.
2      IN       PTR     fw.linkon.dedyn.io.
5      IN       PTR     kabini.linkon.dedyn.io.
7      IN       PTR     x96.linkon.dedyn.io.
